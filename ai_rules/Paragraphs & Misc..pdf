500 0 obj
  << /ActualText (Dividers do not adhere to the 8px system\056 Instead\054 there are 2 types\072 a thick divider with a height of 4px and a width of 64px and a slim divider with a height of 1px and automatic width\056\n\nIf necessary\054 the thick divider can also have an automatic width \050the width of the parent element\051\056\n\nIf keeping up with the vertical rhytm is a must\054 I recommend you offset the difference by adding an additional top or bottom margin of 4px for the thick divider and 7px for the slim one\056)
     /K [ 5 ]
     /P 501 0 R
     /Pg 490 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

501 0 obj
  << /K [ 500 0 R ]
     /P 512 0 R
     /S /P
     /Pg 490 0 R
     /Type /StructElem
  >>
endobj

